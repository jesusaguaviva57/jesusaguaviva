{
  "name": "jesusaguaviva-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway serverless (Cloudflare Workers + Hono) para la web de la iglesia Jesús Agua Viva: lector bíblico (Midvash) y formulario de contacto (Resend).",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail",
    "secret:resend": "wrangler secret put RESEND_API_KEY"
  },
  "dependencies": {
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.87.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
